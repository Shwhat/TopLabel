# TopLabel settings. Copy to .env (command line) or enter these in the stack's environment variables in Dockhand.

# Host port the app is published on. Check it is free with: sudo ss -ltnp | grep ':8431 '
TOPLABEL_PORT=8431

# Folder on the Docker host that holds accounts, saved labels, presets and the symbol library.
# Create it and run: sudo chown -R 65532:65532 /opt/toplabel/data
TOPLABEL_DATA_DIR=/opt/toplabel/data

# Allow new accounts to sign up (true or false). The first account can always be created.
TOPLABEL_SIGNUP=false

# Secure sign-in cookie: auto (secure when reached over HTTPS, including through Cloudflare), always or never.
TOPLABEL_SECURE_COOKIE=auto

# GitHub repository the symbols are downloaded from.
TOPLABEL_VECTORS_REPO=Investigamer/mtg-vectors

# Download the symbol library by itself when the server starts with an empty library (true or false).
TOPLABEL_AUTO_REFRESH=true
